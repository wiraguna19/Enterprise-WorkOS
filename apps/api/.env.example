APP_NAME="Work OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Structured JSON logs with request_id / organization_id / user_id on every
# line (docs/01 §7). Never log tokens, passwords, or file contents.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=workos
DB_USERNAME=workos
DB_PASSWORD=workos

# Redis backs cache, queue, and session. Permission resolution is cached with a
# version counter rather than a TTL, so a role change takes effect immediately
# (docs/06 §2).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_CLIENT=predis

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Attachments never live in the database and never stream through the API
# process (docs/03 §5, docs/05 §6).
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=workos
AWS_SECRET_ACCESS_KEY=workos-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=workos-attachments
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@workos.local"
MAIL_FROM_NAME="${APP_NAME}"

# The web client is the only browser-facing origin; the API itself is a
# stateless bearer-token service (docs/06 §1).
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

# Real-time (docs/07 §8). `null` is the default and a supported way to run this
# product: every screen is correct when polled, and the socket only removes the
# wait. Switch to `reverb` and run `php artisan reverb:start` to turn it on.
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
